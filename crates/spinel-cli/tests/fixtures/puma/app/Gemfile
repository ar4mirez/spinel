source "https://rubygems.org"

# Puma itself, from the checkout the suite runs in, as Puma's own Gemfile
# names it: the suite takes `lib/` at the root for Puma's own.
gemspec

# What runs Puma's own suite, `test/`: Puma 8.1.2's Gemfile less what builds,
# lints or picks tests (rake-compiler, rubocop, m), json held to the 2.18
# Spinel builds in, and minitest held below 6, whose path expander needs the
# prism gem's C half.
group :test do
  gem "json", "~> 2.18.0"
  gem "nio4r", "~> 2.7"
  gem "minitest", ">= 5.26", "< 6"
  gem "minitest-retry"
  gem "minitest-proveit"
  gem "minitest-stub-const"
  gem "concurrent-ruby", "~> 1.3"
  gem "rack", "~> 3.2"
  gem "rackup", "~> 2.3"
  gem "minitest-mock"
  gem "logger"
  gem "localhost", require: false
end
